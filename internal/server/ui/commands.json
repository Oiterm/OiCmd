    },
    "o8": {
     "cmd": "linkagg lacp agg <번호> size <크기> actor admin-key <번호>\nlinkagg lacp port <포트> actor admin-key <번호>",
     "note": "크기는 2/4/8/16. VLAN 은 vlan <VLAN번호> members linkagg <번호> tagged"
    }
   }
